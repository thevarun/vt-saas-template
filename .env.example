# Required environment variables
# Copy this file to `.env.local` and fill in the values (the `.local` file is gitignored).

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Dify (AI chat) ---
DIFY_API_KEY=your_dify_api_key
DIFY_API_URL=https://api.dify.ai/v1

# --- Admin Access Control ---
# Comma-separated list of admin email addresses
# Users with these emails OR user_metadata.isAdmin=true have admin access
# Example: ADMIN_EMAILS=admin@example.com,owner@example.com
ADMIN_EMAILS=

# --- Email (Resend) ---
# Get your API key from https://resend.com/api-keys
# Without API key, emails are logged to console in dev mode
RESEND_API_KEY=re_xxxxxxxx
# Sender configuration (optional - defaults provided)
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=Your App Name
EMAIL_REPLY_TO=support@yourdomain.com

# --- Sentry (Error Monitoring) ---
# Create a project at https://sentry.io and copy the DSN
NEXT_PUBLIC_SENTRY_DSN=
# Required for source map uploads during build
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- GitHub Actions Secrets (not in .env.local) ---
# These are configured in GitHub repo Settings > Secrets:
# - CROWDIN_PROJECT_ID        (translation sync)
# - CROWDIN_PERSONAL_TOKEN    (translation sync)
# - SENTRY_AUTH_TOKEN          (source map uploads in CI)
