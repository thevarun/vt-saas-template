# Required environment variables
# Copy this file to `.env.local` and fill in the values (the `.local` file is gitignored).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Dify (AI chat) - Optional
# The Dify chat feature requires these variables to be set.
# If not configured, the chat page will display a setup message.
#
# Get your API key from https://dify.ai (sign up for free)
# Default API URL: https://api.dify.ai/v1 (use this unless you have a custom Dify instance)
DIFY_API_KEY=your_dify_api_key
DIFY_API_URL=https://api.dify.ai/v1

# Admin Access Control (optional)
# Comma-separated list of admin email addresses
# Users with these emails OR user_metadata.isAdmin=true have admin access
# Example: ADMIN_EMAILS=admin@example.com,owner@example.com
ADMIN_EMAILS=

# Email (Resend)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# Sender configuration (optional - defaults provided)
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=Your App Name
EMAIL_REPLY_TO=support@yourdomain.com
