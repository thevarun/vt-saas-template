{
  "name": "vt-saas-template",
  "version": "1.8.0",
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "dev:spotlight": "spotlight-sidecar",
    "dev:next": "next dev",
    "dev": "run-p dev:*",
    "build": "if [ \"$VERCEL_ENV\" = 'production' ]; then if [ \"$RUN_PROD_MIGRATIONS\" = 'true' ]; then echo '▶ Running production migrations...' && pnpm db:migrate:ci; else echo '⚠️  Skipping build-time migrations (RUN_PROD_MIGRATIONS != true) — set it to enable; see .claude/rules/database.md.'; fi; fi && next build",
    "postbuild": "if [ \"$VERCEL_ENV\" = 'production' ]; then sentry-cli releases deploys \"$VERCEL_GIT_COMMIT_SHA\" new -e production || true; fi",
    "start": "next start",
    "build-stats": "cross-env ANALYZE=true pnpm build",
    "clean": "rimraf .next out coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-types": "tsc --noEmit --pretty",
    "test": "vitest run",
    "test:stories": "VITEST_STORYBOOK=1 vitest run",
    "test:e2e": "playwright test",
    "commit": "cz",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -c production -- drizzle-kit migrate",
    "db:migrate:ci": "drizzle-kit migrate",
    "db:gen-types": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema \"$DB_SCHEMA\" > src/libs/supabase/types.ts.tmp && mv src/libs/supabase/types.ts.tmp src/libs/supabase/types.ts",
    "db:studio": "dotenv -c production -- drizzle-kit studio",
    "email:dev": "email dev --dir src/libs/email/templates --port 3001",
    "email:render": "tsx scripts/render-supabase-templates.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "@assistant-ui/react": "^0.14.26",
    "@assistant-ui/react-ai-sdk": "^1.3.40",
    "@assistant-ui/react-markdown": "^0.14.5",
    "@electric-sql/pglite": "^0.5.4",
    "@hookform/resolvers": "^5.4.0",
    "@logtail/pino": "^0.5.8",
    "@opentelemetry/sdk-trace-node": "^2.6.0",
    "@radix-ui/react-accordion": "^1.2.15",
    "@radix-ui/react-alert-dialog": "^1.1.18",
    "@radix-ui/react-avatar": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.3.6",
    "@radix-ui/react-collapsible": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-navigation-menu": "^1.2.17",
    "@radix-ui/react-popover": "^1.1.18",
    "@radix-ui/react-progress": "^1.1.11",
    "@radix-ui/react-scroll-area": "^1.2.13",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.3.2",
    "@radix-ui/react-tabs": "^1.1.16",
    "@radix-ui/react-toast": "^1.2.18",
    "@radix-ui/react-toggle": "^1.1.13",
    "@radix-ui/react-toggle-group": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.6",
    "@sentry/nextjs": "^10.51.0",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.110.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.20.5",
    "@types/react-dom": "^19.2.3",
    "@vercel/otel": "^2.1.2",
    "ai": "^6.0.177",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "driver.js": "^1.4.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "fast-glob": "3.3.3",
    "framer-motion": "^12.42.2",
    "gray-matter": "4.0.3",
    "inngest": "^4.11.0",
    "langfuse": "^3.38.6",
    "langfuse-vercel": "^3.38.20",
    "lucide-react": "^1.23.0",
    "mem0ai": "^2.4.2",
    "next": "^16.2.10",
    "next-intl": "^4.13.1",
    "next-mdx-remote": "6.0.0",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "posthog-js": "^1.396.8",
    "posthog-node": "^5.39.4",
    "react": "^19.2.7",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.72.1",
    "react-is": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.6",
    "recharts": "^3.9.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.17.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "stripe": "^22.2.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@assistant-ui/react-devtools": "^1.2.8",
    "@axe-core/playwright": "^4.11.2",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/cz-commitlint": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@eslint-react/eslint-plugin": "^5.11.2",
    "@faker-js/faker": "^10.4.0",
    "@next/bundle-analyzer": "^16.2.10",
    "@next/eslint-plugin-next": "^16.2.10",
    "@percy/cli": "1.31.13",
    "@percy/playwright": "^1.1.0",
    "@playwright/test": "^1.61.1",
    "@react-email/preview-server": "^5.2.10",
    "@sentry/cli": "^2.58.5",
    "@spotlightjs/spotlight": "^4.11.3",
    "@storybook/addon-links": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/nextjs-vite": "^10.4.6",
    "@storybook/react": "^10.4.6",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/expect": "^4.1.10",
    "commitizen": "^4.3.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.5.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-playwright": "^2.10.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "http-server": "^14.1.1",
    "husky": "^9.1.6",
    "jiti": "^2.6.1",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.4.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.12",
    "react-email": "^5.2.10",
    "rimraf": "^6.0.1",
    "semantic-release": "^25.0.5",
    "shadcn": "^4.7.0",
    "start-server-and-test": "^3.0.4",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.19.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "vitest-fail-on-console": "^0.10.1"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits",
          "presetConfig": {
            "types": [
              {
                "type": "feat",
                "section": "Features"
              },
              {
                "type": "fix",
                "section": "Bug Fixes"
              },
              {
                "type": "perf",
                "section": "Performance"
              },
              {
                "type": "revert",
                "section": "Reverts"
              },
              {
                "type": "chore",
                "hidden": true
              },
              {
                "type": "docs",
                "hidden": true
              },
              {
                "type": "style",
                "hidden": true
              },
              {
                "type": "refactor",
                "hidden": true
              },
              {
                "type": "test",
                "hidden": true
              },
              {
                "type": "ci",
                "hidden": true
              },
              {
                "type": "build",
                "hidden": true
              }
            ]
          }
        }
      ],
      "@semantic-release/github"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@playwright/test",
      "@sentry/cli",
      "@sentry/nextjs",
      "drizzle-kit",
      "esbuild",
      "husky",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "axios": ">=1.13.5",
      "cookie": "^0.7.2",
      "esbuild": "^0.25.1",
      "glob": "^10.4.6"
    }
  }
}
